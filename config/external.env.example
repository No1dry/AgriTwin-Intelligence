# Copy to .env.kimi.local in the project root. Keep all values private.
# Official Moonshot API only. Actions already uses repository secret MOONSHOT_API_KEY.
MOONSHOT_API_KEY=

# Optional: QWeather dedicated host, and ONE authentication method.
# Without these, official alerts remain explicitly disconnected.
QWEATHER_API_HOST=
QWEATHER_API_KEY=
QWEATHER_JWT=

# Optional for higher public metadata/search quotas.
OPENALEX_API_KEY=
GITHUB_SOURCE_TOKEN=
